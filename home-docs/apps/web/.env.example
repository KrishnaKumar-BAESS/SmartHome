# Copy to .env.local and fill in your local settings.
# Opt in to showing the street address and plat in the top bar and Quick Facts.
VITE_SHOW_ADDRESS=false

# Server-only Pi-hole v6 connection for pnpm dev / pnpm preview.
# Generate an app password in Pi-hole Settings > Web interface / API.
# Never prefix this password with VITE_.
PIHOLE_URL=http://192.168.0.254
PIHOLE_APP_PASSWORD=
