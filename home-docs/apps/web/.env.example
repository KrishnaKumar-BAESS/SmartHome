# Copy to .env.local and fill in your local settings.
# Opt in to showing the street address and plat in the top bar and Quick Facts.
VITE_SHOW_ADDRESS=false

# Server-only Pi-hole v6 connection for pnpm dev / pnpm preview.
# Generate an app password in Pi-hole Settings > Web interface / API.
# Never prefix this password with VITE_.
PIHOLE_URL=http://192.168.0.254
PIHOLE_APP_PASSWORD=

# Built-server settings (pnpm --filter @smarthome/home-docs start).
# Keep loopback for development; LAN deployment uses 192.168.0.202.
HOUSE_HOST=127.0.0.1
HOUSE_PORT=8090
# Optional absolute path to a copied web build; defaults to this app's dist/.
# HOUSE_WEB_ROOT=/path/to/release/web
# Containers bind internally to all interfaces; publish only the LAN address.
# HOUSE_BIND=0.0.0.0
