{
  "name": "@smarthome/home-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "vite build && tsc -p tsconfig.server.json && node scripts/bundle-budget.mjs",
    "test:e2e": "playwright test",
    "start": "node --env-file-if-exists=.env.local build/server/index.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
