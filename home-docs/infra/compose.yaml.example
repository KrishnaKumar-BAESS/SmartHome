services:
  smarthome:
    image: node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9
    container_name: smarthome
    user: "1000:1000"
    working_dir: /app
    # The application binds only HOUSE_HOST, not every host interface.
    network_mode: host
    command: ["node", "server/index.js"]
    env_file: service.env.local
    volumes:
      - ./current:/app:ro
    read_only: true
    cap_drop: [ALL]
    security_opt: [no-new-privileges:true]
    restart: unless-stopped
    mem_limit: 128m
    pids_limit: 64
    healthcheck:
      test: ["CMD", "node", "-e", "fetch('http://'+process.env.HOUSE_HOST+':'+process.env.HOUSE_PORT+'/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
      interval: 30s
      timeout: 5s
      retries: 3
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
