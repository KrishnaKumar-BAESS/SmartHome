# Copy to .env.local. Never commit account/session credentials or captures.
PORT=4318
# Local-only client credential from the operator's installed Xfinity app configuration.
# Required for account mode; never put it in a browser build or commit it.
XFINITY_CLIENT_SECRET=
# Leave empty to use the normal Android SDK location on Windows, or adb on PATH.
ADB_PATH=
# Exact signaling hosts independently verified from your Xfinity app traffic.
# The app refuses to send viewing tokens to hosts outside this list.
XFINITY_SIGNALING_HOSTS=
# Optional display names keyed by camera MAC (12 hexadecimal characters).
CAMERA_NAMES={}
